<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher ground: rich navy, lit from the top — reads BLUE at 48px where
     the old flat #002946 washed out to gray next to other icons (Brian,
     Aug 30, home-screen screenshot). The raster mipmaps bake the same look
     for pre-adaptive launchers. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="315"
        android:startColor="#0D4A75"
        android:centerColor="#04304F"
        android:endColor="#021A2E"
        android:type="linear" />
</shape>
