<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Foreground ("while using the app") location: Go Live crew tracking,
         the map's locate-me, clock-in. Without these the WebView auto-denies
         navigator.geolocation and the OS prompt never shows. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Camera: the label scanner on Trackers → Add trackers and Assets →
         Scan trackers (getUserMedia). Undeclared, the WebView auto-denies
         the request and the scanner silently falls back to typing. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The scanner's short buzz on a read: without this the WebView's
         navigator.vibrate is a silent no-op (a normal permission, no prompt). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Microphone: talking to Ask AI and the map search (v1.5.2, Sep 19 2026 —
         Brian: "Talk to ai verbally button not working"). The WebView's own
         speech API has no recognition service behind it, so voice goes
         through @capacitor-community/speech-recognition — Android's
         SpeechRecognizer — which needs RECORD_AUDIO (a plain runtime
         permission, no Play declaration). The plugin's manifest declares it
         too; repeated here so the intent is visible. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Shift recording (v1.4.0/1.4.1, Sep 9 2026 — Brian: "mandatory tracking
         thru app while clocked in", "native background tracking is a must"):
         while a person is CLOCKED IN, @capacitor-community/background-geolocation
         runs a location FOREGROUND service (persistent notification) so the
         shift keeps recording with the screen off. That needs only "While
         using the app" location — deliberately NO background-location
         permission (the plugin never requests it, and declaring it would put
         the release through Play's background-location review for nothing;
         ship-check). The plugin's own manifest declares the foreground-service
         permissions and POST_NOTIFICATIONS; repeated here so the intent is visible. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Job photos keep their OWN GPS coordinates (Brian, Sep 12: "I want the
         gps coordinates of photos"). Since Android 10 the system REDACTS the
         GPS tags out of every image handed to an app; the only way back to the
         original is MediaStore.setRequireOriginal() while holding
         ACCESS_MEDIA_LOCATION, which a WebView file chooser never does. So
         OriginalPhotosPlugin owns the gallery door.

         READ_MEDIA_VISUAL_USER_SELECTED is requested alongside READ_MEDIA_IMAGES
         on Android 14+, so the system offers "Select photos" and most people
         never grant the whole library.

         Nov 7 (v1.5.6): READ_MEDIA_IMAGES and READ_MEDIA_VISUAL_USER_SELECTED
         are OUT. Declaring them sends every release through Play's Photo and
         Video Permissions declaration, and that one form held back every app
         update from Sep 12 to Nov 7: talking to the app, the Back button, crash
         recovery, the no-signal screen (board #140). Brian, Nov 7: "fix why the
         voice talk mode isn't working". So Android 10–12 keep the original-photo
         door (READ_EXTERNAL_STORAGE below), and on Android 13+ the plugin reports
         itself unavailable and the page uses the WebView's own file input —
         exactly what installed phones have done since Sep 12: a gallery photo
         with no readable GPS asks where it was taken; photos taken in the app
         carry the live fix. To bring originals back on 13+: re-add the two
         lines, file the declaration (wording in docs/APP-STORE-PLAYBOOK.md),
         release. The removes below make sure no library merges them back in. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove" />
</manifest>
