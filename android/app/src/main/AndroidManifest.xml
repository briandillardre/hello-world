<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Foreground ("while using the app") location: Go Live crew tracking,
         the map's locate-me, clock-in. Without these the WebView auto-denies
         navigator.geolocation and the OS prompt never shows. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Camera: the label scanner on Trackers → Add trackers and Assets →
         Scan trackers (getUserMedia). Undeclared, the WebView auto-denies
         the request and the scanner silently falls back to typing. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Shift recording (v1.4.0/1.4.1, Sep 9 2026 — Brian: "mandatory tracking
         thru app while clocked in", "native background tracking is a must"):
         while a person is CLOCKED IN, @capacitor-community/background-geolocation
         runs a location FOREGROUND service (persistent notification) so the
         shift keeps recording with the screen off. That needs only "While
         using the app" location — deliberately NO background-location
         permission (the plugin never requests it, and declaring it would put
         the release through Play's background-location review for nothing;
         ship-check). The plugin's own manifest declares the foreground-service
         permissions and POST_NOTIFICATIONS; repeated here so the intent is visible. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
</manifest>
