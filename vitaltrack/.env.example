# VitalTrack env vars. App runs fully in DEMO MODE with none of these set.

# ── Supabase (real data mode) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (advisor chat + lab PDF parsing) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=              # optional, default claude-haiku-4-5-20251001

# ── Junction (ex-Vital) wearable sync ──
JUNCTION_API_KEY=             # from app.junction.com (sandbox is free, 50 users)
JUNCTION_WEBHOOK_SECRET=      # svix whsec_... from the Junction webhook config
JUNCTION_API_BASE=            # optional; default https://api.sandbox.tryvital.io
                              # set https://api.tryvital.io for production
