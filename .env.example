# Supabase project credentials
# Get these from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Map tile provider
# Get a free key at https://www.maptiler.com (100k tile loads/month free)
# If left as placeholder, app falls back to free CARTO tiles
NEXT_PUBLIC_MAPTILER_KEY=YOUR_MAPTILER_KEY

# ── Tracker ingestion (flespi) ──────────────────────────────────────────────
# Token your flespi stream sends in the x-flespi-token header.
# Leave unset in demo mode (the endpoint accepts and reports mode:demo).
FLESPI_WEBHOOK_TOKEN=

# ── QuickBooks Online integration ───────────────────────────────────────────
# Create an app at https://developer.intuit.com (scope: com.intuit.quickbooks.accounting)
# Leave QBO_CLIENT_ID unset to run QuickBooks in demo mode.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/qbo/callback
QBO_ENVIRONMENT=sandbox

# ──────────────────────────────────────────────────────────────────────────────
# DEMO MODE: If NEXT_PUBLIC_SUPABASE_URL is the placeholder above, the app
# runs in demo mode with mock data (Nashville, TN construction site).
# No database required to evaluate the app.
# ──────────────────────────────────────────────────────────────────────────────

# ── Tax parcel overlay (optional, free) ─────────────────────────────────────
# Any public county/state ArcGIS parcel LAYER url (ends in /MapServer/<n> or
# /FeatureServer/<n>). When set, the map's layers panel gains a "Parcel lines"
# toggle that draws tax parcel boundaries + numbers at street zoom.
# Find yours: county GIS site → ArcGIS REST Services Directory → Parcels
# service → click the parcel layer → copy the URL.
# Greenville County SC directory: https://www.gcgis.org/arcgis/rest/services
NEXT_PUBLIC_PARCEL_SERVICE_URL=

# ── Alerts delivery (optional; unset = in-app only) ──────────────────────────
# SMS theft/geofence alerts via Twilio. All three required for SMS to send.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Fallback SMS recipient when a company has no alert_phone set (pilot use).
ALERT_SMS_TO=
# Optional: POST every fired alert to any URL (Slack relay, Zapier, etc.)
NOTIFY_WEBHOOK_URL=
# Optional: natural-language AI dispatcher on the /map "Ask" box (uses Haiku).
ANTHROPIC_API_KEY=
